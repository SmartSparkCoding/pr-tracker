---
interface Props {
  currentPath?: string;
}
const { currentPath = '' } = Astro.props;
---

<header class="site-header">
  <div class="nav-container">
    <a href="https://jacob.navaratne.uk" class="logo" aria-label="Jacob Navaratne home">Jacob Navaratne</a>
    <nav aria-label="Main navigation">
      <ul>
        <li><a href="https://jacob.navaratne.uk" class:list={{ 'current': currentPath === '/' }}>Home</a></li>
        <li><a href="https://jacob.navaratne.uk/portfolio" class:list={{ 'current': currentPath.startsWith('/portfolio') }}>Portfolio</a></li>
        <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>PR Tracker</a></li>
      </ul>
    </nav>
    <a href="https://github.com/SmartSparkCoding/pr-tracker" target="_blank" rel="noopener noreferrer" class="contact-link">Add a PR ↗</a>
  </div>
</header>
